// data_table.templ
// Generated by Sigil — do not edit manually
package components

// Column defines a table column.
type Column struct {
    Field    string
    Label    string
    Sortable bool
}

// DataTableProps defines the props for the DataTable component.
type DataTableProps struct {
    ID       string
    Columns  []Column
    HxGet    string
    HxTarget string
    PageSize int
}

templ DataTable(props DataTableProps) {
    <div id={ props.ID } class="sigil-data-table">
        <table class="w-full">
            <thead>
                <tr>
                    for _, col := range props.Columns {
                        if col.Sortable {
                            <th class="cursor-pointer" hx-get={ props.HxGet + "?sort=" + col.Field } hx-target={ "#" + props.ID }>
                                { col.Label }
                            </th>
                        } else {
                            <th>{ col.Label }</th>
                        }
                    }
                </tr>
            </thead>
            <tbody hx-get={ props.HxGet } hx-trigger="load" hx-target="this">
                <!-- Rows loaded via HTMX -->
            </tbody>
        </table>
    </div>
}
