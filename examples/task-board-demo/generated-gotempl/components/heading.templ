// heading.templ
// Generated by Sigil — do not edit manually
package components

import "fmt"

// HeadingProps defines the props for the Heading component.
type HeadingProps struct {
    Level int    // 1-6
    Text  string
}

templ Heading(props HeadingProps) {
    switch props.Level {
        case 1:
            <h1 class="text-2xl font-bold text-[rgb(var(--sigil-text))]">{ props.Text }</h1>
        case 2:
            <h2 class="text-xl font-semibold text-[rgb(var(--sigil-text))]">{ props.Text }</h2>
        case 3:
            <h3 class="text-lg font-semibold text-[rgb(var(--sigil-text))]">{ props.Text }</h3>
        case 4:
            <h4 class="text-base font-medium text-[rgb(var(--sigil-text))]">{ props.Text }</h4>
        default:
            <h2 class="text-xl font-semibold text-[rgb(var(--sigil-text))]">{ props.Text }</h2>
    }
}
