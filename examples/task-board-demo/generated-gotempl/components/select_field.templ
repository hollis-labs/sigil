// select_field.templ
// Generated by Sigil — do not edit manually
package components

// SelectOption represents a dropdown option.
type SelectOption struct {
    Value string
    Label string
}

// SelectProps defines the props for the Select component.
type SelectProps struct {
    Name     string
    Label    string
    Options  []SelectOption
    Required bool
    Value    string
}

templ SelectField(props SelectProps) {
    <div class="flex flex-col gap-1">
        if props.Label != "" {
            <label class="sigil-label" for={ props.Name }>{ props.Label }</label>
        }
        <select name={ props.Name } id={ props.Name } class="sigil-input" required?={ props.Required }>
            for _, opt := range props.Options {
                <option value={ opt.Value } selected?={ opt.Value == props.Value }>{ opt.Label }</option>
            }
        </select>
    </div>
}
