// text.templ
// Generated by Sigil — do not edit manually
package components

// TextProps defines the props for the Text component.
type TextProps struct {
    Content string
    Variant string // body, muted, small
}

templ Text(props TextProps) {
    switch props.Variant {
        case "muted":
            <p class="text-sm text-[rgb(var(--sigil-text-muted))]">{ props.Content }</p>
        case "small":
            <p class="text-xs text-[rgb(var(--sigil-text))]">{ props.Content }</p>
        default:
            <p class="text-base text-[rgb(var(--sigil-text))]">{ props.Content }</p>
    }
}
