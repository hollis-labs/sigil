package components

// SearchBarProps defines the props for the SearchBar component.
type SearchBarProps struct {
    Placeholder string
    HxGet       string
    HxTarget    string
    Debounce    int // milliseconds
}

templ SearchBar(props SearchBarProps) {
    <input
        type="search"
        class="sigil-input w-full"
        placeholder={ props.Placeholder }
        if props.HxGet != "" {
            hx-get={ props.HxGet }
        }
        if props.HxTarget != "" {
            hx-target={ props.HxTarget }
        }
        hx-trigger={ fmt.Sprintf("input changed delay:%dms", props.Debounce) }
    />
}
