// task-board.templ
// Generated by Sigil — do not edit manually
package pages

templ TaskBoard() {
    // Page: Task Board
    // Overlay: page
        <div class="flex flex-col gap-6 p-6">
            <div class="flex flex-row gap-4 justify-between items-center">
                <div class="flex flex-col gap-1">
                    <h1 class="text-2xl font-bold text-[rgb(var(--sigil-text))]">Task Board</h1>
                    <p class="text-base text-[rgb(var(--sigil-text))]">Manage your team's tasks and track progress</p>
                </div>
                <div class="flex flex-row gap-2">
                    <button class="sigil-btn sigil-btn-outline"><span>Export</span></button>
                    <button class="sigil-btn sigil-btn-primary" hx-get="/ui/modals/create-task" hx-target="#modal-container" hx-swap="innerHTML"><span class="icon icon-plus"></span> <span>New Task</span></button>
                </div>
            </div>
            <div class="flex flex-row gap-4 items-center">
                <input type="search" class="sigil-input w-full" placeholder="Search tasks..." hx-get="/api/tasks" hx-trigger="input changed delay:300ms" hx-target="#table-tasks"/>
                <select name="" class="sigil-input">
                    <option value="all">All Statuses</option>
                    <option value="todo">To Do</option>
                    <option value="in-progress">In Progress</option>
                    <option value="review">In Review</option>
                    <option value="done">Done</option>
                </select>
                <select name="" class="sigil-input">
                    <option value="all">All Priorities</option>
                    <option value="critical">Critical</option>
                    <option value="high">High</option>
                    <option value="medium">Medium</option>
                    <option value="low">Low</option>
                </select>
            </div>
            <div class="flex flex-row gap-4">
                <span class="sigil-badge sigil-badge-default">24 tasks</span>
                <span class="sigil-badge sigil-badge-info">8 in progress</span>
                <span class="sigil-badge sigil-badge-success">12 done</span>
            </div>
            <div id="table-tasks" class="sigil-data-table">
                <table class="w-full">
                    <thead>
                        <tr>
                            <th>Task</th>
                            <th>Status</th>
                            <th>Assignee</th>
                            <th hx-get="/api/tasks?sort=priority" hx-target="#table-tasks" class="cursor-pointer">Priority</th>
                            <th hx-get="/api/tasks?sort=created_at" hx-target="#table-tasks" class="cursor-pointer">Created</th>
                        </tr>
                    </thead>
                    <tbody hx-get="/api/tasks" hx-trigger="load" hx-target="this">
                        <!-- Rows loaded via HTMX -->
                    </tbody>
                </table>
            </div>
            <hr class="sigil-separator"/>
        </div>
}
